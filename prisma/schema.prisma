generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventVisibility {
  PRIVATE
  LINK_ONLY
}
enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum ReservationStatus {
  RESERVED
  PURCHASED
  CANCELLED
  EXPIRED
}
enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
}
enum RSVPStatus {
  PENDING
  ATTENDING
  DECLINED
}

enum EventRole {
  HOST
  COHOST
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  events        Event[]  @relation("EventOwner")
  membership    EventMember[]
  sentInvites    EventInvite[] @relation("InvitedBy")
  issuedLinks    InvitationLink[] @relation("LinkIssuer")
  notificationPreferences NotificationPreference?
  reservations  Reservation[]
  media         Media[]
  contributions Contribution[]
  adminAccount AdminAccount?
  moderationReviews AbuseReport[] @relation("ReportReviewer")
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")
}

model Event {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String?         @db.VarChar(1500)
  occasion    String
  location    String?
  date        DateTime
  visibility  EventVisibility @default(PRIVATE)
  status      EventStatus     @default(DRAFT)
  accessCodeHash String?
  ownerId     String
  owner       User            @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     EventMember[]
  invitations EventInvite[]
  invitationLinks InvitationLink[]
  gifts       Gift[]
  reservations Reservation[]
  media       Media[]
  funds       GiftFund[]
  contributions Contribution[]
  abuseReports AbuseReport[]
  guests      Guest[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([ownerId])
}

model EventMember {
  id       String    @id @default(cuid())
  eventId  String
  userId   String
  role     EventRole @default(COHOST)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([eventId, userId])
  @@index([userId])
}

model EventInvite {
  id          String   @id @default(cuid())
  eventId     String
  email       String
  invitedById String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@unique([eventId, email])
  @@index([email])
}

model Gift {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title        String
  url          String?
  pricePaise   Int?
  category     String?
  note         String?
  priority     Int      @default(2)
  quantity     Int      @default(1)
  reservations Reservation[]
  fund         GiftFund?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([eventId])
}

model Reservation {
  id          String            @id @default(cuid())
  giftId      String
  eventId     String
  guestUserId String?
  visitorId   String?
  gift        Gift              @relation(fields: [giftId], references: [id], onDelete: Cascade)
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest       User?             @relation(fields: [guestUserId], references: [id], onDelete: SetNull)
  status      ReservationStatus @default(RESERVED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([giftId, status])
  @@index([giftId, visitorId, status])
  @@index([eventId])
}

model Guest {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  rsvp      RSVPStatus @default(PENDING)
  visitorId String?
  partySize Int       @default(1)
  updatedAt DateTime  @updatedAt
  createdAt DateTime @default(now())
  @@index([eventId])
  @@unique([eventId, visitorId])
}

model Media {
  id        String      @id @default(cuid())
  eventId   String
  uploaderId String?
  visitorId String?
  storageKey String     @unique
  mimeType  String
  sizeBytes Int
  fileName  String     @db.VarChar(160)
  album     String     @default("Moments") @db.VarChar(60)
  status    MediaStatus @default(PENDING)
  uploadedAt DateTime?
  uploadExpiresAt DateTime
  reviewedAt DateTime?
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploader  User?      @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  abuseReports AbuseReport[]
  createdAt DateTime    @default(now())
  @@index([eventId, status, uploadedAt])
  @@index([visitorId, eventId])
}


/// Invitation links are *bearer capabilities*: their raw token is never persisted.
/// Revocation and expiry are checked on every guest request and mutation.
model InvitationLink {
  id          String    @id @default(cuid())
  eventId     String
  createdById String
  label       String    @db.VarChar(80)
  tokenHash   String    @unique @db.VarChar(64)
  expiresAt   DateTime
  maxUses     Int?
  useCount    Int       @default(0)
  revokedAt   DateTime?
  allowMediaView Boolean @default(false)
  allowMediaUpload Boolean @default(false)
  createdAt   DateTime  @default(now())
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("LinkIssuer", fields: [createdById], references: [id], onDelete: Cascade)
  @@index([eventId, revokedAt])
}

/// Opt-in choices only; no automated messages are sent by this milestone.
model NotificationPreference {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailUpdates Boolean  @default(false)
  whatsappUpdates Boolean @default(false)
  updatedAt    DateTime @updatedAt
}


// A pledge is NOT a payment. No funds move until approved compliant provider onboarding.
enum FundStatus {
  OPEN
  CLOSED
}
enum ContributionStatus {
  PLEDGED
  PAYMENT_PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
  CANCELLED
}
model GiftFund {
  id            String      @id @default(cuid())
  eventId       String
  giftId        String      @unique
  targetPaise   Int
  status        FundStatus  @default(OPEN)
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gift          Gift        @relation(fields: [giftId], references: [id], onDelete: Cascade)
  contributions Contribution[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@index([eventId, status])
}
model Contribution {
  id              String             @id @default(cuid())
  fundId          String
  eventId         String
  visitorId       String?
  guestUserId     String?
  amountPaise     Int
  currency        String             @default("INR") @db.VarChar(3)
  status          ContributionStatus @default(PLEDGED)
  providerOrderId String?            @unique @db.VarChar(100)
  providerPaymentId String?          @unique @db.VarChar(100)
  paidAt          DateTime?
  refundedAt      DateTime?
  fund            GiftFund           @relation(fields: [fundId], references: [id], onDelete: Cascade)
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest           User?              @relation(fields: [guestUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  @@index([fundId, status])
  @@index([visitorId, fundId])
}
model PaymentWebhookReceipt {
  id              String   @id @default(cuid())
  provider        String   @default("RAZORPAY_TEST")
  providerEventId String   @unique @db.VarChar(130)
  eventType       String   @db.VarChar(80)
  receivedAt      DateTime @default(now())
}

enum AdminRole {
  ADMIN
  MODERATOR
}
enum ReportReason {
  PRIVACY
  INAPPROPRIATE_MEDIA
  SPAM
  OTHER
}
enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}
model AdminAccount {
  userId String @id
  role AdminRole
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
model AbuseReport {
  id String @id @default(cuid())
  eventId String
  mediaId String?
  reporterFingerprint String @db.VarChar(64)
  reason ReportReason
  details String? @db.VarChar(600)
  status ReportStatus @default(OPEN)
  reviewerId String?
  resolutionNote String? @db.VarChar(300)
  reviewedAt DateTime?
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  reviewer User? @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([eventId, status])
  @@index([reporterFingerprint, createdAt])
}
model AdminAuditLog {
  id String @id @default(cuid())
  actorId String
  actor User @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action String @db.VarChar(80)
  targetType String @db.VarChar(40)
  targetId String @db.VarChar(100)
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([actorId, createdAt])
}

# PostgreSQL connection URL; use a dedicated local development database
DATABASE_URL="postgresql://saugaat:saugaat@localhost:5432/saugaat?schema=public"
# Generate securely with: openssl rand -base64 48
SESSION_SECRET="REPLACE_WITH_RANDOM_LONG_SECRET_AT_LEAST_32_CHARACTERS"

# Used for full invitation links and QR codes. Must be your trusted deployment origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Private S3-compatible storage (not a public bucket)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Browser-accessible CORS origin must match NEXT_PUBLIC_SITE_URL for direct uploads.

# Group gifting: disabled pending merchant, beneficiary and legal approvals.
PAYMENTS_MODE=disabled
# Test keys only. Never commit live keys.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=

# Milestone 8: launch hardening. Set true when private media is a required launch feature.
REQUIRE_PRIVATE_MEDIA_STORAGE=false
# Production requires HTTPS origin, unique SESSION_SECRET, non-example DB credentials and disabled payments.
